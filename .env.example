# Keep all secrets server-side. Never put private secrets in NEXT_PUBLIC_ variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Photon Beta (2.0). Only set after provisioning a project.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_SPACE_ID=
PHOTON_BASE_URL=https://api.photon.codes/v1
# Set to true ONLY to enable outbound messaging actions.
ENABLE_REAL_DISPATCH=false
